# MediCall AI — Backend Environment Variables
# Copy to .env and fill in your values

# Database (Local PostgreSQL + pgvector)
DATABASE_URL=postgresql://medicall:medicall@localhost:5432/medicall

# Redis (Local)
REDIS_URL=redis://localhost:6379

# Telephony (Multi-provider for India)
# Exotel
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_SID=your-exotel-sid
EXOTEL_TOKEN=your-exotel-token

# Knowlarity
KNOWLARITY_API_KEY=your-knowlarity-api-key
KNOWLARITY_SIP_URI=your-knowlarity-sip-uri

# Twilio India
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-india-number

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Deepgram (Multi-language STT)
DEEPGRAM_API_KEY=your-deepgram-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# ElevenLabs (Multi-language TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID_HINDI=your-hindi-voice-id
ELEVENLABS_VOICE_ID_TAMIL=your-tamil-voice-id
ELEVENLABS_VOICE_ID_TELUGU=your-telugu-voice-id
ELEVENLABS_VOICE_ID_BENGALI=your-bengali-voice-id
ELEVENLABS_VOICE_ID_ENGLISH=21m00Tcm4TlvDq8ikWAM

# Payments (Multi-gateway for India)
# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# PhonePe
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1

# Cashfree
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# Frontend URL (for CORS and payment links)
FRONTEND_URL=http://localhost:3000

# App
DEBUG=true
LOG_LEVEL=debug
ENVIRONMENT=development